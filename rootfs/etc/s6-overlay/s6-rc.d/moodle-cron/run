#!/command/with-contenv sh
# Moodle cron — per-minute `php admin/cli/cron.php` loop.
# Disable Moodle's internal cron keep-alive so this wrapper, not Moodle, owns
# the per-minute cadence. The timeout remains as a guard for genuinely stuck
# ticks.

# Default-on; explicit-disable accepts the usual falsey spellings.
case "${ENABLE_MOODLE_CRON:-TRUE}" in
    [Ff][Aa][Ll][Ss][Ee]|0|[Nn][Oo]|[Nn]|[Oo][Ff][Ff])
        exec sleep infinity
        ;;
esac

cd /var/www/html || exit 1

# Skip until install has finished. The bootstrap entrypoint runs before s6
# starts services, but if the operator misconfigured DB and install bailed,
# don't busy-loop cron errors.
while [ ! -s /data/config/config.php ]; do sleep 5; done

while :; do
    start=$(date +%s)
    # BusyBox timeout (Alpine) uses short flags: -s SIG, -k SECS, then DURATION.
    timeout -s TERM -k 5 55 \
        php admin/cli/cron.php --keep-alive=0 >&2 || true
    elapsed=$(( $(date +%s) - start ))
    if [ "$elapsed" -lt 60 ]; then
        sleep $(( 60 - elapsed ))
    fi
done
